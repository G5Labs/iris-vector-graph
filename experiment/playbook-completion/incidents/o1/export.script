 kill  set dir="/tmp/o1export/" do ##class(%File).RemoveDirectoryTree(dir) do ##class(%File).CreateDirectoryChain(dir_"SYS/") do ##class(%File).CreateDirectoryChain(dir_"FC/")
 zn "%SYS" set c="IVGDev." for { set c=$order(^oddDEF(c)) quit:c=""  quit:$extract(c,1,7)'="IVGDev."  set sc=$system.OBJ.ExportUDL(c_".cls",dir_"SYS/"_c_".cls",,,"UTF8") write "SYS ",c," ",sc,! }
 zn "IVG262FC1306" set c="" for { set c=$order(^oddDEF(c)) quit:c=""  if $extract(c)'="%" { set sc=$system.OBJ.ExportUDL(c_".cls",dir_"FC/"_c_".cls",,,"UTF8") write "FC ",c," ",$select(sc=1:1,1:0),! } }
 halt
