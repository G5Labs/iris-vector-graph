   "        lowered = sql.strip().upper()",
   "        if lowered in (\"START TRANSACTION\", \"COMMIT\", \"ROLLBACK\",",
   "                       \"BEGIN\", \"BEGIN TRANSACTION\"):",
   "            self._rs = None",
   "            self._rows = None",
   "            self.description = None",
   "            self.rowcount = -1",
   "            return"
  ]
