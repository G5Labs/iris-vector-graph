QUERY USE GRAPH 'g' OPTIONAL MATCH (n:Report) RETURN n.k AS k,count(*) AS star,count(n.v) AS c,sum(n.v) AS s,avg(n.v) AS a
SELECT Graph_KG.CY_TYPED(%EXACT(p2.val)) AS k, COUNT(*) AS star, COUNT(%EXACT(p3.val)) AS c, Graph_KG.CY_TYPED(CASE WHEN MAX(Graph_KG.CY_IS_FLOAT(%EXACT(p4.val))) = 1 THEN CAST(SUM(%EXACT(p4.val)) AS DOUBLE) ELSE CASE WHEN SUM(%EXACT(p4.val)) IS NULL THEN CAST(0 AS INTEGER) ELSE SUM(%EXACT(p4.val)) END END) AS s, AVG(%EXACT(p5.val)) AS a
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p3 ON p3.s = n0.node_id AND p3."key" = ? AND COALESCE(p3.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p4 ON p4.s = n0.node_id AND p4."key" = ? AND COALESCE(p4.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p5 ON p5.s = n0.node_id AND p5."key" = ? AND COALESCE(p5.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '') AND 1=1
GROUP BY %EXACT(p2.val)
UNION ALL
SELECT NULL, 1, 0, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM Graph_KG.rdf_labels WHERE COALESCE(graph_id, '') = COALESCE('g', '') AND label = ?)
PARAMS [['Report', 'k', 'v', 'v', 'v', 'Report']]
