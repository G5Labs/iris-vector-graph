QUERY USE GRAPH 'g' MATCH (n:Report) RETURN collect(n.v) AS xs
SELECT COALESCE('[' || LIST(NULLIF(CASE WHEN Graph_KG.CY_JSON_NUM(%EXACT(p2.val)) IS NOT NULL THEN Graph_KG.CY_JSON_NUM(%EXACT(p2.val)) WHEN %EXACT(p2.val) = 'true' OR %EXACT(p2.val) = 'false' THEN %EXACT(p2.val) WHEN %EXACT(p2.val) = '' THEN '""' ELSE COALESCE(Graph_KG.CY_JSON_LISTMAP(%EXACT(p2.val)), TRIM(TRAILING ']' FROM SUBSTRING(JSON_ARRAY(%EXACT(p2.val)), 2))) END, 'null')) || ']', CAST('[]' AS VARCHAR(256))) AS xs
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '') AND 1=1
PARAMS [['Report', 'v']]
