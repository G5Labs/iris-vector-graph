USE GRAPH 'g' MATCH (n:Report) RETURN n.k AS k,count(*) AS c ORDER BY c DESC SKIP 1 LIMIT 1
SELECT * FROM (
SELECT ROW_NUMBER() OVER(ORDER BY __sort0 DESC) AS __rn, __q.* FROM (SELECT Graph_KG.CY_TYPED(%EXACT(p2.val)) AS k, COUNT(*) AS c, %EXACT(Graph_KG.CY_SORT_KEY(COUNT(*), 'x')) AS __sort0
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '') AND 1=1
GROUP BY %EXACT(p2.val)) __q
) __paged WHERE __rn > 1 AND __rn <= 2 ORDER BY __rn
