UNWIND [1, null, 1, 2.5] AS x RETURN collect(x) AS xs,collect(DISTINCT x) AS dx
SELECT COALESCE(JSON_ARRAYAGG(u0.x), CAST('[]' AS VARCHAR(256))) AS xs, COALESCE(JSON_ARRAYAGG(DISTINCT u0.x), CAST('[]' AS VARCHAR(256))) AS dx
FROM (SELECT ? AS x UNION ALL SELECT NULL AS x UNION ALL SELECT ? AS x UNION ALL SELECT ? AS x) u0
{'parameters': [[1, 1, 2.5]], 'query_metadata': QueryMetadata(estimated_rows=None, index_usage=[], optimization_applied=[], complexity_score=None, warnings=[]), 'bolt_column_types': ['scalar', 'scalar'], 'json_value_columns': ['xs', 'dx'], 'return_arity': 2, 'select_aliases': ['xs', 'dx']}
UNWIND [false,true,null] AS x RETURN collect(x) AS xs
SELECT COALESCE('[' || LIST(NULLIF(CASE WHEN u0.x = 1 THEN 'true' WHEN u0.x = 0 THEN 'false' ELSE 'null' END, 'null')) || ']', CAST('[]' AS VARCHAR(256))) AS xs
FROM (SELECT ? AS x UNION ALL SELECT ? AS x UNION ALL SELECT NULL AS x) u0
