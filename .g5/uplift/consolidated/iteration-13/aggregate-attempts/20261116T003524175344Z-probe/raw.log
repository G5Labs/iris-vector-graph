USE GRAPH 'g' MATCH (n:Report) RETURN count(*) AS allrows,count(n.v) AS nonnull,count(DISTINCT n.v) AS uniq
SELECT COUNT(*) AS allrows, COUNT(%EXACT(p2.val)) AS nonnull, COUNT(DISTINCT %EXACT(p3.val)) AS uniq
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p3 ON p3.s = n0.node_id AND p3."key" = ? AND COALESCE(p3.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '') AND 1=1
{'parameters': [['Report', 'v', 'v']], 'query_metadata': QueryMetadata(estimated_rows=None, index_usage=[], optimization_applied=[], complexity_score=None, warnings=[]), 'bolt_column_types': ['scalar', 'scalar', 'scalar'], 'graph_context': 'g', 'int_expr_columns': ['allrows', 'nonnull', 'uniq'], 'return_arity': 3, 'select_aliases': ['allrows', 'nonnull', 'uniq']}
USE GRAPH 'g' MATCH (n:Report) RETURN n.k AS k,count(*) AS c,sum(n.v) AS total,avg(n.v) AS mean
SELECT Graph_KG.CY_TYPED(%EXACT(p2.val)) AS k, COUNT(*) AS c, Graph_KG.CY_TYPED(CASE WHEN MAX(Graph_KG.CY_IS_FLOAT(%EXACT(p3.val))) = 1 THEN CAST(SUM(%EXACT(p3.val)) AS DOUBLE) ELSE CASE WHEN SUM(%EXACT(p3.val)) IS NULL THEN CAST(0 AS INTEGER) ELSE SUM(%EXACT(p3.val)) END END) AS total, AVG(%EXACT(p4.val)) AS mean
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p3 ON p3.s = n0.node_id AND p3."key" = ? AND COALESCE(p3.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p4 ON p4.s = n0.node_id AND p4."key" = ? AND COALESCE(p4.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '') AND 1=1
GROUP BY %EXACT(p2.val)
{'parameters': [['Report', 'k', 'v', 'v']], 'query_metadata': QueryMetadata(estimated_rows=None, index_usage=[], optimization_applied=[], complexity_score=None, warnings=[]), 'bolt_column_types': ['scalar', 'scalar', 'scalar', 'scalar'], 'graph_context': 'g', 'bool_text_columns': [0], 'int_expr_columns': ['c'], 'float_expr_columns': ['mean'], 'prop_text_expr_columns': ['k'], 'typed_value_columns': ['k', 'total'], 'return_arity': 4, 'select_aliases': ['k', 'c', 'total', 'mean']}
USE GRAPH 'g' MATCH (n:Report) WITH sum(n.v) AS s RETURN s
WITH Stage1 AS (
SELECT CASE WHEN MAX(Graph_KG.CY_IS_FLOAT(p2.val)) = 1 THEN CAST(SUM(p2.val) AS DOUBLE) ELSE CASE WHEN SUM(p2.val) IS NULL THEN CAST(0 AS INTEGER) ELSE SUM(p2.val) END END AS s
FROM Graph_KG.nodes n0
JOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.label = ? AND COALESCE(l1.graph_id, '') = COALESCE('g', '')
LEFT JOIN Graph_KG.rdf_props p2 ON p2.s = n0.node_id AND p2."key" = ? AND COALESCE(p2.graph_id, '') = COALESCE('g', '')
WHERE l1.s IS NOT NULL AND COALESCE(n0.graph_id, '') = COALESCE('g', '')
)
SELECT Graph_KG.CY_TYPED(Stage1.s) AS s
FROM Stage1
WHERE 1=1
