{"q": "MATCH (a:I58C080800A) OPTIONAL MATCH (a)-[:K080800]->(b) RETURN a.name, collect(b.name), sum(b.v), avg(b.v) ORDER BY a.name", "rows": [["a1", ["b1", "b2"], 30, 15.0], ["a2", [], 0, null]], "sql": "SELECT Graph_KG.CY_TYPED(%EXACT(p4.val)) AS a_name, COALESCE('[' || LIST(NULLIF(CASE WHEN Graph_KG.CY_JSON_NUM(%EXACT(p5.val)) IS NOT NULL THEN Graph_KG.CY_JSON_NUM(%EXACT(p5.val)) WHEN %EXACT(p5.val) = 'true' OR %EXACT(p5.val) = 'false' THEN %EXACT(p5.val) WHEN %EXACT(p5.val) = '' THEN '\"\"' ELSE COALESCE(Graph_KG.CY_JSON_LISTMAP(%EXACT(p5.val)), TRIM(TRAILING ']' FROM SUBSTRING(JSON_ARRAY(%EXACT(p5.val)), 2))) END, 'null')) || ']', CAST('[]' AS VARCHAR(256))) AS collect_b_name_, Graph_KG.CY_TYPED(CASE WHEN MAX(Graph_KG.CY_IS_FLOAT(%EXACT(p6.val))) = 1 THEN CAST(SUM(%EXACT(p6.val)) AS DOUBLE) ELSE CASE WHEN SUM(%EXACT(p6.val)) IS NULL THEN CAST(0 AS INTEGER) ELSE SUM(%EXACT(p6.val)) END END) AS sum_b_v_, AVG(%EXACT(p7.val)) AS avg_b_v_\nFROM Graph_KG.nodes n0\nJOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.graph_id = n0.graph_id AND l1.label = ?\nLEFT OUTER JOIN Graph_KG.rdf_edges e3 ON e3.s = n0.node_id AND e3.graph_id = n0.graph_id AND e3.p = ?\nLEFT OUTER JOIN Graph_KG.nodes n2 ON n2.node_id = e3.o_id AND n2.graph_id = e3.graph_id\nLEFT JOIN Graph_KG.rdf_props p4 ON p4.s = n0.node_id AND p4.graph_id = n0.graph_id AND p4.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p5 ON p5.s = n2.node_id AND p5.graph_id = n2.graph_id AND p5.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p6 ON p6.s = n2.node_id AND p6.graph_id = n2.graph_id AND p6.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p7 ON p7.s = n2.node_id AND p7.graph_id = n2.graph_id AND p7.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p8 ON p8.s = n0."}
