{"q": "MATCH (a:I58C080800A) OPTIONAL MATCH (a)-[:NONE080800]->(b) RETURN a.name, count(b), count(*) ORDER BY a.name", "rows": [["a1", 0, 1], ["a2", 0, 1]], "sql": "SELECT Graph_KG.CY_TYPED(%EXACT(p4.val)) AS a_name, COUNT(n2.node_id) AS count_b_, COUNT(*) AS count___\nFROM Graph_KG.nodes n0\nJOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.graph_id = n0.graph_id AND l1.label = ?\nLEFT OUTER JOIN Graph_KG.rdf_edges e3 ON e3.s = n0.node_id AND e3.graph_id = n0.graph_id AND e3.p = ?\nLEFT OUTER JOIN Graph_KG.nodes n2 ON n2.node_id = e3.o_id AND n2.graph_id = e3.graph_id\nLEFT JOIN Graph_KG.rdf_props p4 ON p4.s = n0.node_id AND p4.graph_id = n0.graph_id AND p4.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p5 ON p5.s = n0.node_id AND p5.graph_id = n0.graph_id AND p5.\"key\" = ?\nWHERE l1.s IS NOT NULL\nGROUP BY %EXACT(p4.val)\nORDER BY %EXACT(Graph_KG.CY_SORT_KEY(p5.val, 'x')) ASC"}
