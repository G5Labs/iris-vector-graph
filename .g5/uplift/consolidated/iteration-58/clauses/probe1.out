{"q": "MATCH (a:I58C080800A) OPTIONAL MATCH (a)-[:K080800]->(b) WHERE b.v = 10 OR b.v = 30 RETURN a.name, b.name ORDER BY a.name, b.name", "rows": [["a1", "b1"], ["a2", null]], "sql": "SELECT Graph_KG.CY_TYPED(%EXACT(p4.val)) AS a_name, Graph_KG.CY_TYPED(%EXACT(p5.val)) AS b_name\nFROM Graph_KG.nodes n0\nJOIN Graph_KG.rdf_labels l1 ON l1.s = n0.node_id AND l1.graph_id = n0.graph_id AND l1.label = ?\nLEFT OUTER JOIN (Graph_KG.rdf_edges e3 JOIN Graph_KG.nodes n2 ON n2.node_id = e3.o_id AND n2.graph_id = e3.graph_id) ON e3.s = n0.node_id AND e3.graph_id = n0.graph_id AND e3.p = ? AND ((SELECT val FROM Graph_KG.rdf_props WHERE s = n2.node_id AND \"key\" = ?) IN ('10', '10.0') OR (SELECT val FROM Graph_KG.rdf_props WHERE s = n2.node_id AND \"key\" = ?) IN ('30', '30.0'))\nLEFT JOIN Graph_KG.rdf_props p4 ON p4.s = n0.node_id AND p4.graph_id = n0.graph_id AND p4.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p5 ON p5.s = n2.node_id AND p5.graph_id = n2.graph_id AND p5.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p6 ON p6.s = n0.node_id AND p6.graph_id = n0.graph_id AND p6.\"key\" = ?\nLEFT JOIN Graph_KG.rdf_props p7 ON p7.s = n2.node_id AND p7.graph_id = n2.graph_id AND p7.\"key\" = ?\nWHERE l1.s IS NOT NULL\nORDER BY %EXACT(Graph_KG.CY_SORT_KEY(p6.val, 'x')) ASC, %EXACT(Graph_KG.CY_SORT_KEY(p7.val, 'x')) ASC"}
