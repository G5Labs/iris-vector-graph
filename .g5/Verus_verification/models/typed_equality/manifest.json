    },
    {
      "label": "json-boolean-reads-as-word",
      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_rel_bool_equals_integer\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "stored-integer-not-a-spelling",
      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_node_true_exact\", \"theorem_node_where_return_disagree\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "binding",
      "kind": "binding",
      "variant": "as-built bounded transcription",
      "expect": null
    },
    {
      "label": "twin-spelling-dropped",
      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_rel_twin_spelling_equals_integer\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "rel-ordering-typed",
      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_rel_text_orders_as_cast\", \"theorem_rel_bool_orders_as_number\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "node-ordering-cast",
      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_node_text_never_orders\", \"theorem_rel_text_orders_as_cast\"], \"verdict\": \"EXPECTED_FAIL\"}"
