      "kind": "control",
      "variant": "as-built bounded transcription",
      "expect": "{\"fail_in\": [\"theorem_node_true_exact\", \"theorem_node_where_return_disagree\", \"theorem_rel_integer_equals_true\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
