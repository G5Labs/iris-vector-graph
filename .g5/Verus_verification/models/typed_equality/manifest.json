{
  "title": "typed equality",
  "question": "Cypher WHERE equality and ordering of a stored node property or relationship qualifier against boolean/integer literals, versus the accepted node_read and rel_prop_text RETURN readers; SQL comparison, JSON_VALUE spelling, IRIS text-to-double cast and stored-double value are providers",
  "ontology_ids": [
