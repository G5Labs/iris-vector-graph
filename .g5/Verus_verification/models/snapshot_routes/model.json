        "theorem_index_result_and_failed_record"
      ]
    },
    {
      "name": "failed-record-still-updates",
      "find": "if record && s.registry.contains_key(key)",
      "replace": "if s.registry.contains_key(key)",
      "expect_fail_in": [
        "theorem_index_result_and_failed_record"
      ]
    },
    {
      "name": "merge-overwrites",
      "find": "} else if merge && s.rows.contains_key(key) {\n        Load{state:s,reported:1}",
      "replace": "} else if merge && s.rows.contains_key(key) {\n        Load{state:State{rows:s.rows.insert(key,v),..s},reported:1}",
      "expect_fail_in": [
        "theorem_merge_reports_without_overwrite"
      ]
    },
    {
