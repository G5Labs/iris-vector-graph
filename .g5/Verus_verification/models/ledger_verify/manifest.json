{
  "title": "ledger verify",
  "question": "what verify compares (nodes by ID across graphs, from node, label or property rows; reserved properties left out; edge rows whose temporal qualifier is the JSON boolean true left out of the tables, statements whose temporal qualifier is the text \"true\" left out of the replay; relationships by tuple), the entries it reports for unrecorded writes, when adopting them makes the next verify equal, and that a relationship stored with temporal text \"true\" never verifies equal",
  "ontology_ids": [
    "ledger.verify",
    "ledger.verify.scope",
    "ledger.unrecorded"
  ],
  "runs": [
    {
      "label": "proof",
      "kind": "proof",
      "variant": "as-built transcription",
      "expect": "{\"errors\": 0, \"verified\": 15}"
    },
    {
      "label": "adopt-without-cascade",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"lemma_adopt_agrees\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "new-entity-attributes-dropped",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"lemma_adopt_agrees\", \"theorem_entries_for_created_and_deleted_nodes\", \"theorem_orphan_property_reports_node\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "adopt-when-equal",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_adoption_only_when_needed\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "graph-scoped-node-identity",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_node_identity_ignores_graph\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "reserved-kept",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_reserved_properties_left_out\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "temporal-row-governed",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_temporal_marked_rows_left_out\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "replay-keeps-marked",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_temporal_marked_rows_left_out\", \"lemma_replay_view_dropped\", \"theorem_marker_rules_differ\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "statement-ids-compared",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_statement_ids_not_compared\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "one-marker-rule",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_text_marker_never_equal\", \"theorem_marker_rules_differ\", \"theorem_temporal_marked_rows_left_out\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "text-marker-premise-dropped",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_adoption_closes_the_difference\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "no-redrop",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_adoption_never_closes_a_text_marker\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "node-from-node-rows-only",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"lemma_canonical_wf\", \"theorem_orphan_property_reports_node\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "binding",
      "kind": "binding",
      "variant": "as-built transcription",
      "expect": null
    }
  ]
}
