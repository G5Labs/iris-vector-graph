      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"lemma_export_import_key\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "reader-loses-graph",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_wrong_graph_and_empty_sources\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
      "label": "attrs-not-written",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_writer_derives_direction_and_attrs\"], \"verdict\": \"EXPECTED_FAIL\"}"
    },
    {
