    {
      "label": "binding",
      "kind": "binding",
      "variant": "as-built transcription",
      "expect": null
    },
    {
      "label": "scalar-typing-assumed-preserved",
      "kind": "control",
      "variant": "as-built transcription",
      "expect": "{\"fail_in\": [\"theorem_numeric_attribute_becomes_text\"], \"verdict\": \"EXPECTED_FAIL\"}"
    }
  ]
