    "erasure.kept",
    "erasure.atomic",
    "erasure.atomic.routes",
    "erasure.count",
    "erasure.entry-points",
    "erasure.entry-points.single-path",
    "erasure.prefix-match",
    "search.erasure",
    "search.erasure.indexes",
    "algorithms.cache.erasure",
    "structure.degree.cache.erase",
    "structure.degree.cache.uncommitted"
